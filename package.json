{
  "name": "valoer-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Valoer Open Banking — monorepo (web, api, admin) — DevMove",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter valoer-web dev",
    "dev:admin": "pnpm --filter valoer-admin dev",
    "dev:api": "pnpm --filter valoer-api dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "build:web": "pnpm --filter valoer-web build",
    "build:admin": "pnpm --filter valoer-admin build",
    "build:api": "pnpm --filter valoer-api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
