{
  "name": "valoer-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Valoer Open Banking — monorepo (web, api, admin) — DevMove",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @valoer/web dev",
